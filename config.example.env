# =============================================================
# grab_a1 — exemplo de configuração
# Copie para `config.env` e edite. Carregue antes de rodar com:
#     set -a; source config.env; set +a
# =============================================================

# Perfil dentro de ~/.oci/config (default: DEFAULT)
OCI_PROFILE=DEFAULT

# OCID do compartimento alvo (use a root tenancy se não tiver outro)
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OCID da subnet pública (deve ter prohibit_public_ip_on_vnic=False)
OCI_SUBNET_ID=ocid1.subnet.oc1.sa-saopaulo-1.xxxxxxxxxxxxxxxxxxxxxxxxxx

# OCID da imagem Oracle Linux 9 (aarch64) — listar com:
#   oci compute image list -c <COMP> --operating-system "Oracle Linux" \
#       --operating-system-version "9" --shape VM.Standard.A1.Flex
OCI_IMAGE_ID=ocid1.image.oc1.sa-saopaulo-1.xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Availability Domain — formato: <prefixo-4-chars>:SA-SAOPAULO-1-AD-N
# Listar o seu com: oci iam availability-domain list
OCI_AD_NAME=xxxx:SA-SAOPAULO-1-AD-1

# Identificação e SSH
OCI_DISPLAY_NAME=a1-free-grabbed
OCI_SSH_KEY_PATH=~/.ssh/id_rsa.pub

# Shape — Always Free permite até 4 OCPU + 24GB RAM no total para A1.
OCI_OCPUS=4
OCI_MEMORY_GB=24
OCI_BOOT_VOLUME_GB=50

# Intervalo aleatório entre tentativas (segundos). Não baixar de 20.
SLEEP_MIN=30
SLEEP_MAX=60

# Telegram — crie um bot com @BotFather; chat_id via getUpdates.
TELEGRAM_BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_CHAT_ID=000000000
